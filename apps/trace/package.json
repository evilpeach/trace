{
  "name": "@trace/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check-generated --workspace @trace/report-contract && tsc --noEmit && vite build",
    "check": "npm run check-generated --workspace @trace/report-contract && tsc --noEmit",
    "test": "npm run check-generated --workspace @trace/report-contract && vitest run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@trace/report-contract": "*",
    "@xyflow/react": "^12.11.6",
    "diff": "^9.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
